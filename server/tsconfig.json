{
  "compilerOptions": {
    // 目标环境是 Node 18+，与 Vercel Functions 的 Node.js 运行时对齐
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2022"
    ],
    "types": [
      "node"
    ],
    // 允许在 TS 源码中写 .js 扩展名的导入
    // 比如：import { parseMoveString } from "../api/chessRules.js";
    // "allowImportingTsExtensions": false,
    // ESM 项目里通常需要
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": false,
    "skipLibCheck": true,
    // 对 server 目录，我们希望可以单独编译输出 JS
    "outDir": "./dist",
    "rootDir": "..",
    // 避免影响前端的 bundler 解析规则
    "resolveJsonModule": true
  },
  "include": [
    "./**/*.ts",
    "./**/*.tsx",
    "./**/*.js",
    "../api/**/*.ts"
  ]
}